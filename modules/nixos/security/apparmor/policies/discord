# AppArmor profile for Discord (Electron), adapted from ubuntu 20.04's
# usr.bin.chromium-browser profile, reworked for NixOS store paths.
# Tokens are substituted at eval time:
#   @discord_dir@   ${pkg}/${dir}, e.g. <store-path>/opt/Discord
#   @discord_exec@  .<binary>-wrapped, the real ELF behind the nixpkgs wrapper
# No unix/network/ptrace/signal rules on purpose: absence keeps those classes
# unmediated, file/capability confinement is the main win.
#include <tunables/global>

# For the nix-chromium abstraction rules (variables work in rules)
@{app_dir} = @discord_dir@
@{app_exec} = @discord_exec@

# Attachment spec must use the literal substituted paths: the parser does
# not expand @{variables} in profile attachments (profile loads but never
# attaches, silently leaving the app unconfined).
profile discord @discord_dir@/@discord_exec@ flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/fonts>
  #include <abstractions/nix-gui>
  #include <abstractions/nix-chromium>

  # Discord-specific writable data
  owner @{HOME}/.cache/discord/ rw,
  owner @{HOME}/.cache/discord/** rwk,
  owner @{HOME}/.cache/discord/**/Cache/** mrw,
  owner @{HOME}/.config/discord/ rw,
  owner @{HOME}/.config/discord/** rwk,
  owner @{HOME}/.config/discord/**/Cache/** mrw,
}
