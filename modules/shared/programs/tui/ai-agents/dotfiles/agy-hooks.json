{
  "notifications": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/antigravity-cli/hooks/agy-notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.gemini/antigravity-cli/hooks/agy-notify.sh"
      }
    ]
  }
}
