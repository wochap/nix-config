max-items 0
reload-threads 5
auto-reload yes
reload-time 60
user-agent "newsboat/2.43 (personal RSS reader)"
prepopulate-query-feeds yes
external-url-viewer "urlscan -dc -r 'smart-open {}'"
goto-next-feed no

# Compact lists with the feed category kept visible as the first column.
feedlist-title-format "Feeds  •  %t sources  •  %U unread"
feedlist-format " %3i  %n  %-12T │ %t%> %5U / %-5c"
articlelist-title-format "%T  •  %u unread"
articlelist-format " %4i  %f  %D  %t"

# Key navigation
bind-key d pagedown
bind-key u pageup
bind-key g home feedlist
bind-key g home articlelist
bind-key g home article
bind-key G end feedlist
bind-key G end articlelist
bind-key G end article
bind-key a toggle-article-read
bind-key n next-unread
bind-key N prev-unread
bind-key v show-urls
bind-key o open-in-browser-and-mark-read
bind-key O open-in-browser

browser smart-open
macro B set browser "smart-open --gui" ; open-in-browser ; set browser smart-open
macro T set browser "smart-open --tui" ; open-in-browser ; set browser smart-open
macro a set browser "tsp yt-dlp --embed-metadata -xic -f bestaudio/best --restrict-filenames" ; open-in-browser ; set browser smart-open
macro m set browser "setsid -f mpv" ; open-in-browser ; set browser smart-open
macro w set browser "kitty @ launch --type=tab sh -c 'reader --image-mode kitty %u && kitty @ scroll-window start && zsh'" ; open-in-browser ; toggle-article-read "read" ; set browser smart-open
macro c set browser "echo %u | wl-copy --trim-newline" ; open-in-browser ; set browser smart-open
macro s set browser "article-summary %u </dev/null >/dev/null 2>&1 &" ; open-in-browser-noninteractively ; toggle-article-read "read" ; set browser smart-open

include ~/.config/newsboat/theme

# vim: filetype=conf
